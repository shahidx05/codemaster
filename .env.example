# =============================================================================
# .env.example — Root environment template for docker-compose.yml
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Use the compose service name as host when running via docker compose.
# Swap for your Atlas URI when deploying to production.
MONGODB_URI=mongodb://mongo:27017/codemaster

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_secure_random_secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
# Comma-separated list of allowed CORS origins (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ── Redis ─────────────────────────────────────────────────────────────────────
# Use the compose service name as host when running via docker compose.
REDIS_URL=redis://redis:6379

# ── Optional ──────────────────────────────────────────────────────────────────
# Judge0 CE API key for higher rate limits (https://ce.judge0.com)
# Leave blank to use the public free tier
JUDGE0_API_KEY=