# Build output (generated by vite build — never commit or copy raw)
dist/

# Dependencies — reinstalled fresh inside the image
node_modules/

# Environment files — VITE_* vars are baked in at build time via ARG/ENV,
# never via .env files committed to the image
.env
.env.*
!.env.example

# Version control
.git/
.gitignore

# Logs
logs/
*.log
npm-debug.log*

# OS artefacts
.DS_Store
Thumbs.db

# Editor metadata
.vscode/
.idea/

# Docker files themselves
Dockerfile
.dockerignore